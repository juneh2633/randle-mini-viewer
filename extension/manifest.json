{
  "manifest_version": 3,
  "name": "랜들 미니 뷰어",
  "version": "1.1.0",
  "description": "랜들 숫자를 미니 창에서 확인하고 자리 선택, 리롤, 확정, 다음 판을 직접 조작합니다. 자동 반복 기능은 없습니다.",
  "content_scripts": [{
    "matches": ["https://randle.lixx.kr/play", "https://randle.lixx.kr/play/*"],
    "js": ["viewer.js", "content.js"],
    "run_at": "document_idle"
  }],
  "icons": {"128": "icon.png"}
}
